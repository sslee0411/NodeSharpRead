<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NodeSharp.Tests
    ====================
    단위/통합 테스트 프로젝트(xUnit). 02번 설계 문서 1번 탭 폴더 구조의 test\NodeSharp.Tests\에 대응.

    Step: CT-01c (03번 개발 Step맵.html, Phase 1)
    - 원래 이 프로젝트 생성은 Phase 14 OP-06(테스트 하네스)에 있었으나, CT-02a(Msg 모델)부터
      완료 기준이 "단위 테스트로 확인"을 요구하는데 그때까지 테스트를 돌릴 프로젝트 자체가
      없는 구조적 공백을 발견해 이 Step으로 앞당겼다(README v1.46, 03번 문서 v1.21 근거).
    - OP-06은 이 프로젝트의 신규 생성이 아니라, 그동안 누적된 테스트가 CI에서 한 번에
      통과하는지 확인하고 커버리지 설정을 추가하는 역할로 범위가 조정되었다.

    Step: NR-03a (03번 개발 Step맵.html, Phase 7)
    - InjectNode(Inject 노드의 첫 구현체)를 실제 FlowEngine 배포·라우팅 경로로 검증하기 위해
      nodes\NodeSharp.Nodes.Inject\NodeSharp.Nodes.Inject.csproj ProjectReference 추가.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>NodeSharp.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- xUnit 테스트 프레임워크 + VS/dotnet test 러너 어댑터 + 코드 커버리지 수집기(OP-06에서 실제 사용) -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- CT-02a(Msg)부터 Contracts의 Models/Enums를 테스트하므로 Contracts만 우선 참조.
         이후 Runtime/Registry 등을 테스트해야 하는 Step(RT-*, LL-*)에서 필요할 때 추가한다. -->
    <ProjectReference Include="..\..\src\NodeSharp.Contracts\NodeSharp.Contracts.csproj" />
    <!-- CT-06a(03번 개발 Step맵.html) — PluginLoadContext/PluginLoader가 실제로는 Contracts가 아니라
         Registry 소속으로 확정되어(아래 NodeSharp.Registry.csproj 주석 참고) 예상보다 앞당겨 추가. -->
    <ProjectReference Include="..\..\src\NodeSharp.Registry\NodeSharp.Registry.csproj" />
    <!-- CT-06b — SemVer(신규 도입 유틸리티)를 직접 테스트하기 위해 명시적으로 추가
         (Registry → Util로 이미 전이 참조되지만, 테스트 대상을 명확히 하기 위해 직접 참조). -->
    <ProjectReference Include="..\..\src\NodeSharp.Util\NodeSharp.Util.csproj" />
    <!-- RT-01a(03번 개발 Step맵.html) — FlowEngine(NodeSharp.Runtime 최초 코드)을 테스트하기 위해 추가. -->
    <ProjectReference Include="..\..\src\NodeSharp.Runtime\NodeSharp.Runtime.csproj" />
    <!-- RN-B0(03번 개발 Step맵.html) — NodeSharp.Runner의 Worker(BackgroundService)를 테스트하기 위해 추가.
         Runner는 OutputType=Exe(콘솔/Worker Service)지만 ProjectReference로 그 안의 public 타입을
         그대로 테스트할 수 있음(Program.cs 최상위 문의 진입점은 호출하지 않고 Worker 클래스만 사용). -->
    <ProjectReference Include="..\..\src\NodeSharp.Runner\NodeSharp.Runner.csproj" />
    <!-- NR-03a(03번 개발 Step맵.html) — InjectNode(코어 노드 플러그인, 첫 구현체)를 실제 FlowEngine
         배포·라우팅 경로로 테스트하기 위해 추가. -->
    <ProjectReference Include="..\..\nodes\NodeSharp.Nodes.Inject\NodeSharp.Nodes.Inject.csproj" />
  </ItemGroup>

</Project>
