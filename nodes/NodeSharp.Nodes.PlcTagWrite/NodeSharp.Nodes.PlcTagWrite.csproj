<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NodeSharp.Nodes.PlcTagWrite
    ====================
    PLC 태그 쓰기 예시 노드(ED-D06a, 범위 검사 + 동시 쓰기 락 증명용) 코어 플러그인. 02번 설계 문서
    1번 탭 폴더 구조(nodes\ ← 코어 노드 플러그인, 개별 csproj, Contracts만 참조)에 따라 이 프로젝트는
    NodeSharp.Contracts 하나만 참조합니다(스케줄러 등 Util 기능이 필요 없음).

    Step: ED-D06a (03번 개발 Step맵.html — PLC Write 안전장치)
    - 착수 전 판단(질문 없이 진행 — 확립된 무-질문 운영 방식):
      1) 표 순서상 ED-D05 다음은 ED-D05b("포트 충돌 검사 + UTC 타임스탬프 기준")이지만, 그 설명에
         스스로 "★ 실행 순서 주의"를 명시 — 포트 충돌 검사 부분은 OP-04(통합 FlowLinter, 아직 미착수)
         에 의존하고, UTC 타임스탬프 원칙 부분은 지금 구현할 구체적 대상이 없다(Historian/Alarm/감사
         로그 등 실제로 타임스탬프를 저장하는 기능이 아직 코드에 없음 — grep으로 확인). PD-01a를
         ED-D04보다 먼저 진행했던 선례와 동일한 원칙으로 ED-D05b를 건너뛰고 ED-D06a로 진행한다(자세한
         경위는 03번 Step맵 ED-D05b/ED-D06a 항목 참고).
      2) ED-D06a 완료 기준("범위를 벗어난 값 쓰기는 거부되고, 같은 태그에 대한 동시 쓰기 요청 중
         하나는 락으로 대기하는지 확인")은 PlcTagReadNode(ED-D04)와 동일한 범위 축소 근거로 — 실제
         PLC 쓰기(IProtocolDriver.WriteAsync 연결)에는 TagId→PLC 연결 정보를 해석하는
         IStructureService가 필요한데 아직 어디에도 구현돼 있지 않다 — 진행한다. 이 노드는 실제 PLC
         통신을 직접 수행하지 않고, 그 자리에 테스트 주입 가능한 WriteAction 훅(InjectNode.Scheduler
         와 동일한 관례)을 둔다.
    - PlcTagWriteNode.cs 신규 — IFlowNode 직접 구현. 입력 1개·출력 1개, 범위 검사(MinValue/MaxValue,
      락을 잡기 전에 먼저 검사) → TagId별 static SemaphoreSlim 락 획득 → WriteAction(있으면) 호출 →
      0번 출력 포트로 값 라우팅. 락이 인스턴스가 아니라 TagId 기준인 이유는 완료 기준이 "같은 태그"를
      기준으로 요구하기 때문(클래스 remarks 참고).
    - PlcTagWriteNodeType.cs 신규 — PlcTagReadNodeType과 동일한 관례로 INodeTypeDescriptor 직접 구현.
      PropertySchema에 "tagId"(TagRef, Required), "minValue"/"maxValue"(Number, 선택) 필드 3개.
    - test\NodeSharp.Tests\PlcTagWriteNodeTests.cs 신규, NodeSharp.Tests.csproj ProjectReference 추가
      — Descriptor 등록·Factory·범위 거부·정상 라우팅·동시 쓰기 상호 배제(WriteAction 주입으로 최대
      동시 실행 수 측정)를 xUnit으로 증명. 이 Step의 완료 기준은 PD-01a와 마찬가지로 순수하게
      xUnit으로 검증 가능하지만, 확립된 관례에 따라 사용자의 명시적 확인 후에 Step맵 상태를
      ✅ 완료로 전환한다.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NodeSharp.Nodes.PlcTagWrite</RootNamespace>
    <AssemblyName>NodeSharp.Nodes.PlcTagWrite</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- 02번 문서 1번 탭 폴더 구조 — 코어 노드 플러그인은 Contracts(+필요시 Util)만 참조. 이 노드는
         스케줄러 등 Util 기능이 필요 없어 Contracts만 참조합니다. -->
    <ProjectReference Include="..\..\src\NodeSharp.Contracts\NodeSharp.Contracts.csproj" />
  </ItemGroup>

</Project>
