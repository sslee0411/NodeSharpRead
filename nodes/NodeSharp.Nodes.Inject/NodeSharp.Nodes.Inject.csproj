<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NodeSharp.Nodes.Inject
    ====================
    Inject 노드(캔버스에서 수동/주기적으로 메시지를 발행하는 트리거) 코어 플러그인. 02번 설계 문서
    1번 탭 폴더 구조(line 207 — "nodes\ ← 코어 노드 플러그인, 개별 csproj, Contracts만 참조")에 따라
    이 프로젝트는 원래 NodeSharp.Contracts 하나만 참조했으나, NR-03b부터 NodeSharp.Util도 함께
    참조한다(아래 NR-03b 항목 참고 — 규칙이 "Contracts만"에서 "Contracts+Util"로 완화됨, 02번 문서도
    동일하게 갱신).

    Step: NR-03a (03번 개발 Step맵.html, Phase 7 — Inject 노드, 이 프로젝트의 최초 코드)
    - 착수 전 판단(AskUserQuestion): 완료 기준 "Inject 버튼 클릭 시 정확히 1회 Msg 전달"의 "버튼
      클릭"은 Editor→Runner IPC(실제 배포·실행 중인 Runner 프로세스에 클릭 이벤트를 전달하는 채널)를
      전제하는데, 이 IPC는 아직 없고 NodeSharp.Runner\FlowDeployer.cs 기존 주석이 이미 "Inject/
      Function/Switch/Debug 등 진짜 노드 동작 확인은 Phase 8 LK-02"라고 명시해뒀다(ED-B0.6 Editor/
      Runner 프로세스 분리 결정의 자연스러운 결과). 사용자에게 3가지 범위안을 제시("백엔드만 구현+
      xUnit 검증" / "IPC(LK-02)부터 먼저" / "다른 Step으로 건너뛰기")했고, 사용자가 "백엔드만 구현
      + xUnit 검증"을 선택 — InjectNode의 실제 트리거 로직·디스크립터를 만들고, FlowEngine으로 실제
      배포해 "1회 호출 → 다음 노드가 정확히 1회 수신"을 xUnit으로 증명하는 것으로 완료 기준을
      충족시킨다(완료 기준 문구 자체는 메시지가 정확히 1회 전달되는지를 요구할 뿐 WPF 클릭을 직접
      요구하지 않음 — 이 프로젝트 전체가 "Phase 7 이전엔 WPF 실행 확인 불가, 코드 구조·테스트로
      검증"해온 기존 원칙과 동일). 캔버스의 실제 클릭 버튼 UI·Editor→Runner 전송은 LK-02로 명시적
      으로 미룬다.
    - InjectNode.cs 신규 — IFlowNode 구현(입력 포트 0개·출력 포트 1개, Inject는 Node-RED에서도
      스스로 메시지를 만들어내는 source 노드라 입력을 받지 않음). IFlowNode에는 "외부에서 트리거"할
      방법이 없어(OnInputAsync는 입력 포트로 메시지가 들어올 때만 호출되는데 Inject는 입력 포트가
      0개), 02번 문서 9번 탭 카드7(Inject 설계 스케치)이 이미 "Manual은 Editor의 '노드 클릭' 이벤트가
      별도 채널로 FireAsync를 직접 호출"이라고 명시해둔 대로 IFlowNode 인터페이스 밖에 공개
      TriggerAsync(INodeContext, CancellationToken) 메서드를 추가로 노출 — 외부(지금은 xUnit 테스트,
      향후 LK-02가 붙으면 Editor→Runner 채널)가 이 메서드를 직접 호출해 발행을 트리거한다. Msg를
      새로 만들어 Properties["payload"]를 Payload에 채우고 ctx.RouteAsync(Id, outputPort: 0, msg, ct)
      로 0번 출력에 정확히 1회 전달한다.
    - InjectNodeType.cs 신규 — INodeTypeDescriptor를 NodeTypeDescriptorBuilder(NodeSharp.Registry
      소속) 없이 직접 구현. 이유: 위 폴더 구조 주석이 "nodes 프로젝트는 Contracts만 참조"라고
      명시했는데, INodeTypeDescriptor.cs 자체 예제·NodeTypeDescriptorBuilder.cs 예제는 편의상
      Registry의 빌더 사용을 보여주지만 그 문서 자체도 "직접 구현하는 대신 ... 쓰면"이라고 표현해
      직접 구현이 기본 옵션이고 빌더는 선택적 편의 수단임을 이미 인정하고 있다 — 실제 코어 노드
      플러그인(nodes\ 폴더)은 이 "직접 구현" 경로를 택해 Registry 참조 없이 Contracts.Interfaces.
      INodeTypeDescriptor를 record로 직접 만족시킨다(Registry.NodeTypeRegistry.ScanAssembly는 리플렉션
      으로 "public static INodeTypeDescriptor Descriptor" 필드만 찾으므로 빌더 사용 여부와 무관하게
      정상 스캔된다). Factory는 new InjectNode { Id = cfg.Id, Name = cfg.Name }로 직접 생성(Id가
      { get; init; }라 반사 없이도 초기화 가능 — NodeIdBinder 불필요). PropertySchema에 "payload"
      Text 필드 1개(HelpText/Example 포함, 개발 지침 4번) — Trigger 종류 선택(Manual/Interval/Cron/
      OnDeploy) 필드는 이번 Step 범위인 "수동 트리거"에는 아직 선택할 대상이 하나뿐이라 추가하지
      않음(NR-03b가 Interval 트리거를 추가할 때 실제로 필요해지는 시점에 함께 설계 — GroupDefinition/
      NodeConfig.X·Y·Description이 매번 "지금 필요한 필드만" 최소로 추가해온 것과 동일한 점진적 원칙).
    - test\NodeSharp.Tests\InjectNodeTests.cs 신규 — NodeSharp.Tests.csproj에 이 프로젝트 참조 추가.
      NodeTypeRegistry.ScanAssembly(typeof(InjectNodeType).Assembly)로 Descriptor를 등록하고,
      FlowEngine.DeployAsync로 Inject→CaptureNode(테스트 전용 IFlowNode, 받은 Msg를 리스트에 기록)
      1:1 Wire를 실제 배포한 뒤 InjectNode.TriggerAsync를 정확히 1회 호출해 CaptureNode가 정확히
      1개의 Msg를 받는지 확인(완료 기준의 실질적 증명). tools/check-xmldoc.py 오류 0건, 신규 4개
      파일 중괄호 균형 확인 완료 — 이 세션도 샌드박스에 .NET SDK가 없어 dotnet build/test는 사용자
      로컬 확인 필요(NodeSharp.Contracts/NodeSharp.Tests와 마찬가지로 이 프로젝트도 헤드리스라 원래는
      샌드박스에서 dotnet test가 가능한 유형이지만, 이번 세션은 SDK 자체가 없어 실행하지 못함).
    - ★ 확인(2026-08-10): 사용자가 "업데이트 해주고, 다음단계 진행해줘"로 확인 — 개발 지침 6번
      규칙에 따라 직전 구현(InjectNode/InjectNodeType/xUnit)에 대한 확인으로 해석해 완료 반영
      (03번 Step맵 NR-03a "⏳ 대기" → "✅ 완료"). 실제 WPF 캔버스 클릭·Editor→Runner IPC 시연은
      여전히 LK-02에서 재확인 예정.

    Step: NR-03b (03번 개발 Step맵.html, Phase 7 — Inject 주기(Interval) 트리거)
    - 착수 전 조사·판단 2건(둘 다 AskUserQuestion):
      ① 스케줄러 연결 방식 — RT-08 AsyncSchedulerAdapter/IScheduler를 InjectNode가 어떻게 쓸지
      "InjectNode가 직접 소유"(INodeContext 비변경) vs "INodeContext.Scheduler로 노출"(Contracts+
      Runtime 변경) 2가지 제시. 실제 Node-RED 소스(node-red/node-red 저장소 packages\node_modules\
      @node-red\nodes\core\common\20-inject.js)를 웹에서 확인해 "Node-RED도 Inject 노드가 setInterval/
      clearInterval을 노드 인스턴스 자신이 직접 소유하고 close()에서 스스로 정리하며, 별도 공유
      스케줄러 서비스는 없다"는 선례를 근거로 제시, 사용자가 "InjectNode가 직접 소유"를 선택.
      ② 참조 충돌 — AsyncSchedulerAdapter는 실제로 NodeSharp.Runtime 소속인데, 이 프로젝트는
      "Contracts만 참조" 규칙이라 직접 참조 불가능함을 발견. "Util까지는 허용"(AsyncSchedulerAdapter를
      Runtime→Util로 이동, Util은 Runtime 비의존) vs "포팅(복사)해서 소유"(lssLib 선례와 동일하게 코드
      복사) 2가지 제시, 사용자가 "Util까지는 허용"을 선택 — AsyncSchedulerAdapter.cs가 NodeSharp.Util\
      Messaging\AsyncSchedulerAdapter.cs로 이동(namespace NodeSharp.Runtime → NodeSharp.Util.Messaging,
      동작·시그니처 동일, 자세한 경위는 NodeSharp.Util.csproj/NodeSharp.Runtime.csproj의 NR-03b 항목
      참고), 02번 문서 1번 탭 폴더 구조도 "Contracts만"에서 "Contracts+Util"로 갱신.
    - InjectNode.cs 수정 — TriggerMode(string, 기본 "manual")/IntervalSeconds(double)/
      DefaultPayload(object?) 3개 공개 속성 추가(Factory가 NodeConfig.Properties에서 읽어 채움).
      Scheduler(IScheduler?, settable) 공개 속성 추가 — 지정하지 않으면 OnStartAsync가 기본
      new AsyncSchedulerAdapter()(AsyncScheduler.Instance를 감싼 앱 전체 공유 인스턴스)를 직접 생성,
      테스트에서는 AsyncSchedulerAdapterTests와 동일하게 독립된 AsyncScheduler 인스턴스를 감싼 어댑터를
      주입해 예약 목록이 섞이지 않게 한다. OnStartAsync — TriggerMode가 "interval"이고 IntervalSeconds가
      0보다 크면 Scheduler.SchedulePeriodic(Id, TimeSpan.FromSeconds(IntervalSeconds), () =>
      TriggerAsync(DefaultPayload, ctx, CancellationToken.None))로 등록(ownerId는 이 노드 자신의 Id —
      IScheduler.cs 문서 예제와 동일). OnCloseAsync — Scheduler.Unschedule(Id)로 반드시 해제(공통 규칙
      ②·③, 안 하면 재배포마다 중복 등록). TriggerAsync 자체는 변경 없음(매뉴얼 트리거·인터벌 트리거
      양쪽이 동일한 진입점을 공유 — Node-RED의 emit("input", {})가 once/interval/cron 어디서 오든
      한 곳으로 모이는 구조와 동일한 발상).
    - InjectNodeType.cs 수정 — PropertySchema에 "trigger"(ComboBox, Options: ["manual", "interval"],
      기본값 "manual")·"intervalSeconds"(Number, 기본값 "5") 2개 필드 추가(HelpText/Example 포함,
      개발 지침 4번). Factory가 cfg.Properties에서 "trigger"/"intervalSeconds"/"payload"를 읽어
      InjectNode의 TriggerMode/IntervalSeconds/DefaultPayload에 각각 채운다 — NodeConfig.cs remarks가
      경고한 대로 System.Text.Json 역직렬화 시 JsonElement로 채워질 수 있어 JsonElement/원본 CLR 타입
      양쪽을 모두 처리하는 사설 헬퍼(ReadString/ReadDouble)로 안전하게 변환.
    - test\NodeSharp.Tests\InjectNodeTests.cs에 xUnit 2건 추가 — Interval 모드로 배포하면 약 N회
      주기적으로 발행되는지(AsyncSchedulerAdapterTests와 동일하게 독립 AsyncScheduler 인스턴스 주입,
      짧은 간격(수십 ms)+InRange 허용 오차로 검증), OnCloseAsync 이후에는 더 이상 발행되지 않는지
      (Unschedule 확인). tools/check-xmldoc.py 오류 0건, 수정 파일 중괄호 균형 확인 완료 — 이 세션도
      샌드박스에 .NET SDK가 없어 dotnet build/test는 사용자 로컬 확인 필요.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NodeSharp.Nodes.Inject</RootNamespace>
    <AssemblyName>NodeSharp.Nodes.Inject</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- 02번 문서 1번 탭 폴더 구조 — 코어 노드 플러그인은 Contracts+Util만 참조(Registry/Runtime 비참조,
         NR-03b부터 Util 허용 — 위 NR-03b 항목 참고). -->
    <ProjectReference Include="..\..\src\NodeSharp.Contracts\NodeSharp.Contracts.csproj" />
    <!-- NR-03b: AsyncSchedulerAdapter(Interval 트리거의 IScheduler 구현체)를 직접 소유하기 위해 추가. -->
    <ProjectReference Include="..\..\src\NodeSharp.Util\NodeSharp.Util.csproj" />
  </ItemGroup>

</Project>
