<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NodeSharp.Runner
    ====================
    flows.json을 읽어 실제로 실행하는 헤드리스 콘솔/Worker Service(02번 설계 문서 1번 탭 카드 2~3).
    UseWPF 없음(Editor와 완전히 분리된 무인 실행 전용 프로세스).

    Step: P0-1a (03번 개발 Step맵.html, Phase 0)
    - 이 시점에는 빈 프로젝트 껍데기만 생성한다(Program.cs 없음, OutputType 미지정 → 기본 라이브러리로 빌드).
    - 실행 가능한 콘솔/Worker Service(OutputType=Exe, Program.cs, DI 컨테이너 구성)는
      RN-B0 Step("빈 콘솔/Worker Service 프로젝트")에서 추가한다.

    Step: P0-1b (03번 개발 Step맵.html, Phase 0)
    - 1번 탭 의존성 그림에 따라 ProjectReference 추가: Runner → Contracts, Runner → Runtime, Runner → Registry, Runner → Util.
      (UI.Themes는 참조하지 않음 — Runner는 WPF에 비의존적인 헤드리스 프로세스)

    Step: RN-B0 (03번 개발 Step맵.html, Phase 4 — Phase 3 Registry 완료 이후 첫 Runner Step)
    - OutputType을 Exe로 전환(P0-1a의 "빈 껍데기 = 기본 라이브러리" 상태 종료), Program.cs/Worker.cs
      추가. Microsoft.Extensions.Hosting NuGet 패키지 추가 — 02번 문서에는 Runner가 "콘솔/Worker
      Service"라고만 적혀 있고 구체적으로 어떤 호스팅 프레임워크를 쓸지 정식 선언이 없던 공백이라,
      RN-03a(Windows Service 설치)가 나중에 그대로 얹을 수 있는 .NET 표준 Generic Host(제네릭 호스트)
      패턴(Host.CreateApplicationBuilder + BackgroundService)을 선택 — Windows Service 등록·정상
      종료·DI 컨테이너 구성이 이 패턴에 기본 내장돼 있어 이후 Step에서 재설계할 필요가 없기 때문.
      Worker(BackgroundService)는 이 Step에서는 빈 뼈대(ExecuteAsync가 아무 일도 안 함)만 두고,
      실제 기동 시퀀스(device.json→sequences.json→flows.json→FlowEngine.DeployAsync, 02번 문서
      3번 탭 카드8)는 RN-01에서 이 클래스 안에 채운다.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NodeSharp.Runner</RootNamespace>
    <AssemblyName>NodeSharp.Runner</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- RN-B0 — Generic Host(Host.CreateApplicationBuilder/BackgroundService)로 DI 컨테이너·기동/
         종료 수명주기를 구성. RN-03a(Windows Service 설치)가 그대로 얹을 수 있는 .NET 표준 패턴. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NodeSharp.Contracts\NodeSharp.Contracts.csproj" />
    <ProjectReference Include="..\NodeSharp.Runtime\NodeSharp.Runtime.csproj" />
    <ProjectReference Include="..\NodeSharp.Registry\NodeSharp.Registry.csproj" />
    <ProjectReference Include="..\NodeSharp.Util\NodeSharp.Util.csproj" />
  </ItemGroup>

</Project>
