<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NodeSharp.UI.Themes
    ====================
    WPF 다크/라이트 테마 리소스 딕셔너리(D:\lssLib 기존 WPF 테마 자산을 포팅해 재사용, 02번 설계 문서 1번 탭 카드 2).
    NodeSharp.Editor가 참조해 화면 스타일을 적용한다.

    TargetFramework를 net8.0-windows로, UseWPF를 true로 지정해 ResourceDictionary/Style 등
    WPF 전용 타입을 사용할 수 있게 한다. 실제 테마 XAML/리소스 작성은 ED-B0 Step에서 진행한다.

    Step: P0-1a (03번 개발 Step맵.html, Phase 0)
    - 이 시점에는 빈 프로젝트 껍데기만 생성한다(테마 리소스 없음).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NodeSharp.UI.Themes</RootNamespace>
    <AssemblyName>NodeSharp.UI.Themes</AssemblyName>
  </PropertyGroup>

</Project>
