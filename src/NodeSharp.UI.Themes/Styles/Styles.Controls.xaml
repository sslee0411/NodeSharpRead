     버튼·TextBox·ComboBox·CheckBox 공통 스타일
     출처: D:\lssLib\IIoT\IIoT.Solution\UI\Themes\IIoT.UI.Themes\Styles\Styles.Controls.xaml
           (ED-B4, "복사 참조" 포팅 — 원본과 100% 동일)
     ══════════════════════════════════════════════════════════ -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════════════════════════════════════════════
         §1 ─ 기본 버튼 (ToolbarBtn)
    ════════════════════════════════════════════ -->
    <Style x:Key="ToolbarBtn" TargetType="Button">
        <Setter Property="Background"       Value="{DynamicResource CardBrush}"/>
        <Setter Property="Foreground"       Value="{DynamicResource Text2Brush}"/>
        <Setter Property="BorderBrush"      Value="{DynamicResource Border2Brush}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="Padding"          Value="12,5"/>
        <Setter Property="FontSize"         Value="{DynamicResource FontBase}"/>
        <Setter Property="FontFamily"       Value="{DynamicResource UiFont}"/>
        <Setter Property="FontWeight"       Value="SemiBold"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource RadiusSm}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="root" Property="Background"
                                    Value="{DynamicResource Border2Brush}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="root" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════
         §2 ─ 주 액센트 버튼 (PrimaryBtn)
    ════════════════════════════════════════════ -->
    <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource ToolbarBtn}">
        <Setter Property="Background"  Value="{DynamicResource AccBrush}"/>
        <Setter Property="Foreground"  Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource RadiusSm}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="root" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="root" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════
         §3 ─ 보조 버튼 (SecondaryBtn)
    ════════════════════════════════════════════ -->
    <Style x:Key="SecondaryBtn" TargetType="Button">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="Foreground"       Value="{DynamicResource AccBrush}"/>
        <Setter Property="BorderBrush"      Value="{DynamicResource AccBrush}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="Padding"          Value="12,5"/>
        <Setter Property="FontSize"         Value="{DynamicResource FontBase}"/>
        <Setter Property="FontFamily"       Value="{DynamicResource UiFont}"/>
        <Setter Property="FontWeight"       Value="SemiBold"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource RadiusSm}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="root" Property="Background"
                                    Value="{DynamicResource AccFaintBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="root" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════
         §4 ─ 고스트 버튼 (GhostBtn)
    ════════════════════════════════════════════ -->
    <Style x:Key="GhostBtn" TargetType="Button">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="Foreground"       Value="{DynamicResource Text2Brush}"/>
        <Setter Property="BorderBrush"      Value="Transparent"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="Padding"          Value="8,4"/>
        <Setter Property="FontSize"         Value="{DynamicResource FontBase}"/>
        <Setter Property="FontFamily"       Value="{DynamicResource UiFont}"/>
        <Setter Property="FontWeight"       Value="Normal"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource RadiusSm}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="root" Property="Background"
                                    Value="{DynamicResource CardBrush}"/>
                            <Setter TargetName="root" Property="BorderBrush"
                                    Value="{DynamicResource BorderBrush}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="root" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════
         §5 ─ 위험 버튼 (DangerBtn)
    ════════════════════════════════════════════ -->
    <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ToolbarBtn}">
        <Setter Property="Foreground"  Value="{DynamicResource RedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource RedFaintBrush}"/>
    </Style>

    <!-- ════════════════════════════════════════════
         §6 ─ 성공 버튼 (SuccessBtn)
    ════════════════════════════════════════════ -->
    <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource ToolbarBtn}">
        <Setter Property="Foreground"  Value="{DynamicResource GreenBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GreenFaintBrush}"/>
    </Style>

    <!-- ════════════════════════════════════════════
         §7 ─ 적용 버튼 (ApplyBtn)
    ════════════════════════════════════════════ -->
    <Style x:Key="ApplyBtn" TargetType="Button">
        <Setter Property="Background"      Value="{DynamicResource AccBrush}"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="0,8"/>
        <Setter Property="FontSize"        Value="{DynamicResource FontBase}"/>
        <Setter Property="FontWeight"      Value="Bold"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="FontFamily"      Value="{DynamicResource UiFont}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource RadiusSm}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="root" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="root" Property="Opacity" Value="0.75"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════
         §8 ─ 트리 소형 버튼 (TreeBtn)
    ════════════════════════════════════════════ -->
    <Style x:Key="TreeBtn" TargetType="Button" BasedOn="{StaticResource ToolbarBtn}">
        <Setter Property="Padding"   Value="7,3"/>
        <Setter Property="FontSize"  Value="{DynamicResource FontSm}"/>
        <Setter Property="Margin"    Value="2,0"/>
    </Style>

    <!-- ════════════════════════════════════════════
         §9 ─ TextBox (PropInput) — 속성 편집 패널
    ════════════════════════════════════════════ -->
    <Style x:Key="PropInput" TargetType="TextBox">
        <Setter Property="Background"      Value="{DynamicResource CardBrush}"/>
        <Setter Property="Foreground"      Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Border2Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="7,5"/>
        <Setter Property="FontSize"        Value="{DynamicResource FontBase}"/>
        <Setter Property="FontFamily"      Value="{DynamicResource UiFont}"/>
        <Setter Property="CaretBrush"      Value="{DynamicResource TextBrush}"/>
        <Setter Property="SelectionBrush"  Value="{DynamicResource AccBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource RadiusSm}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="root" Property="BorderBrush"
                                    Value="{DynamicResource AccBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="root" Property="BorderBrush"
                                    Value="{DynamicResource Border2Brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
    ★★ ModernTextBox 별칭 ★★
    PropInput 과 동일 구현 — 기존 키 변경 없이 별칭으로 호환성 유지.
    -->
    <Style x:Key="ModernTextBox" TargetType="TextBox" BasedOn="{StaticResource PropInput}"/>

    <!-- Mono 폰트 TextBox -->
    <Style x:Key="MonoPropInput" TargetType="TextBox" BasedOn="{StaticResource PropInput}">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
    </Style>

    <!-- ════════════════════════════════════════════
         §10 ─ ComboBox (PropCombo) — Full ControlTemplate
    ════════════════════════════════════════════ -->
    <Style x:Key="PropCombo" TargetType="ComboBox">
        <Setter Property="Background"       Value="{DynamicResource CardBrush}"/>
        <Setter Property="Foreground"       Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush"      Value="{DynamicResource Border2Brush}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="Padding"          Value="8,5"/>
        <Setter Property="FontSize"         Value="{DynamicResource FontBase}"/>
        <Setter Property="FontFamily"       Value="{DynamicResource UiFont}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="templateRoot" SnapsToDevicePixels="True">
                        <ToggleButton x:Name="PART_ToggleButton"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen,
                                                  RelativeSource={RelativeSource TemplatedParent},
                                                  Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="tgBorder"
                                            Background="{DynamicResource CardBrush}"
                                            BorderBrush="{DynamicResource Border2Brush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource RadiusSm}">
                                        <Path x:Name="arrow"
                                              Data="M 0 0 L 4 4 L 8 0 Z"
                                              Fill="{DynamicResource Text3Brush}"
                                              Width="8" Height="4"
                                              Stretch="Fill"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"
                                              IsHitTestVisible="False"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="tgBorder" Property="Background"
                                                    Value="{DynamicResource Border2Brush}"/>
                                            <Setter TargetName="arrow" Property="Fill"
                                                    Value="{DynamicResource Text2Brush}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="tgBorder" Property="BorderBrush"
                                                    Value="{DynamicResource AccBrush}"/>
                                            <Setter TargetName="arrow" Property="Fill"
                                                    Value="{DynamicResource AccBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="tgBorder" Property="Opacity" Value="0.4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="contentSite"
                                          Margin="8,4,28,4"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          IsHitTestVisible="False"
                                          TextBlock.Foreground="{DynamicResource TextBrush}"
                                          TextBlock.FontFamily="{DynamicResource UiFont}"
                                          TextBlock.FontSize="{DynamicResource FontBase}"/>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=templateRoot}"
                               PopupAnimation="Fade"
                               Focusable="False">
                            <Border Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource AccBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusSm}"
                                    MinWidth="{Binding ActualWidth, ElementName=templateRoot}">
                                <ScrollViewer MaxHeight="200"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter
                                        KeyboardNavigation.DirectionalNavigation="Contained"
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background"        Value="{DynamicResource CardBrush}"/>
                    <Setter Property="Foreground"        Value="{DynamicResource TextBrush}"/>
                    <Setter Property="Padding"           Value="8,6"/>
                    <Setter Property="FontSize"          Value="{DynamicResource FontBase}"/>
                    <Setter Property="FontFamily"        Value="{DynamicResource UiFont}"/>
                    <Setter Property="FocusVisualStyle"  Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="itemBorder"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}"
                                        BorderThickness="0">
                                    <ContentPresenter
                                        VerticalAlignment="Center"
                                        TextBlock.Foreground="{TemplateBinding Foreground}"
                                        TextBlock.FontSize="{TemplateBinding FontSize}"
                                        TextBlock.FontFamily="{TemplateBinding FontFamily}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="itemBorder" Property="Background"
                                                Value="{DynamicResource AccFaintBrush}"/>
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource AccBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="itemBorder" Property="Background"
                                                Value="{DynamicResource AccBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected"  Value="True"/>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="itemBorder" Property="Background"
                                                Value="{DynamicResource AccBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </MultiTrigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="itemBorder" Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
    ★★ ModernComboBox 별칭 ★★
    PropCombo 와 동일 구현.
    -->
    <Style x:Key="ModernComboBox" TargetType="ComboBox" BasedOn="{StaticResource PropCombo}"/>

    <!-- ════════════════════════════════════════════
         §11 ─ CheckBox
    ════════════════════════════════════════════ -->
    <Style x:Key="DarkCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
        <Setter Property="FontSize"   Value="{DynamicResource FontBase}"/>
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="Cursor"     Value="Hand"/>
    </Style>

    <!-- ════════════════════════════════════════════
         §12 ─ 구분선
    ════════════════════════════════════════════ -->
    <Style x:Key="DividerLine" TargetType="Separator">
        <Setter Property="Background"      Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Height"          Value="1"/>
        <Setter Property="Margin"          Value="0,10"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Divider Border 스타일 (Layout.xaml 에 있으나 Controls 에서도 자주 쓰임) -->
    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height"     Value="1"/>
        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Margin"     Value="0,10"/>
    </Style>

    <!-- ════════════════════════════════════════════
         §13 ─ 메뉴(MenuItem) — 상단 메뉴 바 + 팝업 서브메뉴 공통 테마
         (LK-01 확인 중 사용자가 스크린샷으로 보고: 상단 메뉴("편집" 등)를
         클릭했을 때 열리는 드롭다운이 OS 기본 흰색 목록으로 표시되는 버그)
         근본 원인: MainWindow.xaml의 <Menu>는 Background/Foreground를
         인라인으로 지정했지만, 그 안의 <MenuItem>들이 여는 서브메뉴 Popup은
         MenuItem 자신의 ControlTemplate이 그리는 영역이라 이 저장소 어디에도
         MenuItem 스타일이 정의된 적이 없어(ComboBox의 PropCombo와 달리
         "만들어졌지만 안 쓰인" 것도 아니라 아예 존재하지 않았음) WPF 기본
         Aero 스타일 그대로 노출된 것. x:Key 없는 암시적(implicit) 스타일이라
         이 딕셔너리가 병합된 곳이면 MainWindow.xaml을 건드리지 않아도 모든
         MenuItem(현재의 파일/편집/보기/도움말 메뉴 전부, 향후 추가될
         ContextMenu 포함)에 자동 적용됨. Role(TopLevelHeader/TopLevelItem/
         SubmenuHeader/SubmenuItem)별 Trigger로 메뉴 바 항목과 팝업 안 항목의
         모양을 구분하는 WPF 표준 패턴(PresentationFramework.Aero 기본
         MenuItem 템플릿과 동일한 구조를 이 저장소 색상 리소스로 재구성).
    ════════════════════════════════════════════ -->
    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize"   Value="{DynamicResource FontBase}"/>
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="Padding"    Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadiusSm}"
                                SnapsToDevicePixels="True">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIconColumn"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path x:Name="checkMark"
                                      Grid.Column="0"
                                      Data="M 0 3.5 L 3 7 L 8 0"
                                      Stroke="{DynamicResource AccBrush}"
                                      StrokeThickness="1.6"
                                      Width="10" Height="8"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"/>
                                <ContentPresenter x:Name="headerHost"
                                                  Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}"
                                                  TextBlock.FontSize="{TemplateBinding FontSize}"
                                                  TextBlock.FontFamily="{TemplateBinding FontFamily}"/>
                                <TextBlock x:Name="gestureText"
                                           Grid.Column="2"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="{DynamicResource Text3Brush}"
                                           FontSize="{DynamicResource FontSm}"
                                           FontFamily="{DynamicResource UiFont}"
                                           Margin="24,0,0,0"
                                           VerticalAlignment="Center"/>
                                <Path x:Name="submenuArrow"
                                      Grid.Column="3"
                                      Data="M 0 0 L 4 3.5 L 0 7 Z"
                                      Fill="{DynamicResource Text3Brush}"
                                      Width="4" Height="7"
                                      Margin="14,0,0,0"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               PlacementTarget="{Binding ElementName=root}"
                               Placement="Bottom">
                            <Border Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource Border2Brush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusSm}"
                                    Padding="4"
                                    MinWidth="{Binding ActualWidth, ElementName=root}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.35" Color="Black"/>
                                </Border.Effect>
                                <ScrollViewer CanContentScroll="True"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter Grid.IsSharedSizeScope="True"
                                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="submenuArrow" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="gestureText"  Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="checkMark"    Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_Popup"   Property="Placement"  Value="Bottom"/>
                            <Setter Property="Padding" Value="12,6"/>
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelItem">
                            <Setter TargetName="PART_Popup"   Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="submenuArrow" Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Padding" Value="12,6"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="submenuArrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_Popup"   Property="Placement"  Value="Right"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuItem">
                            <Setter TargetName="PART_Popup" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="root" Property="Background" Value="{DynamicResource AccFaintBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════
         §14 ─ 메뉴 구분선(Separator) — 서브메뉴 팝업 안에서 쓰는 암시적 스타일
         §12의 키 있는 DividerLine(패널용, Margin 0,10)과 별개 — 메뉴 팝업
         안에서는 그만큼 넓은 여백이 어색해 더 좁은 여백으로 새로 정의.
         x:Key가 없어 <Separator/>만 그대로 써도 자동 적용됨(MainWindow.xaml의
         "편집" 메뉴 안 3개 Separator가 대상).
    ════════════════════════════════════════════ -->
    <Style TargetType="Separator">
        <Setter Property="Background"      Value="{DynamicResource Border2Brush}"/>
        <Setter Property="Height"          Value="1"/>
        <Setter Property="Margin"          Value="4,4"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

</ResourceDictionary>
