<!-- ══════════════════════════════════════════════════════════
     NodeSharp.UI.Themes · Styles/Styles.TreeView.xaml
     역할: 장비 트리 TreeView / TreeViewItem 전체 스타일
     출처: D:\lssLib\IIoT\IIoT.Solution\UI\Themes\IIoT.UI.Themes\Styles\Styles.TreeView.xaml
           (ED-B4, "복사 참조" 포팅 — 원본과 100% 동일)
     ══════════════════════════════════════════════════════════ -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════════════════════════════════════════════
         §1 ─ TreeView 컨테이너
    ════════════════════════════════════════════ -->
    <Style x:Key="DeviceTreeView" TargetType="TreeView">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Padding"          Value="4"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing"      Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode"  Value="Recycling"/>
    </Style>

    <!-- ════════════════════════════════════════════
         §2 ─ TreeViewItem (핵심)
         모든 Trigger Setter.Value는 DynamicResource — 테마 전환 시 즉시 반영되도록.
    ════════════════════════════════════════════ -->
    <Style x:Key="DeviceTreeItem" TargetType="TreeViewItem">
        <Setter Property="Background"    Value="Transparent"/>
        <Setter Property="Foreground"    Value="{DynamicResource Text2Brush}"/>
        <Setter Property="FontSize"      Value="{DynamicResource FontBase}"/>
        <Setter Property="FontFamily"    Value="{DynamicResource UiFont}"/>
        <Setter Property="Padding"       Value="6,5"/>
        <Setter Property="Cursor"        Value="Hand"/>
        <Setter Property="IsExpanded"    Value="True"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <!-- 행 자체 -->
                        <Border x:Name="rowBorder"
                                Background="Transparent"
                                CornerRadius="{DynamicResource RadiusSm}"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 확장/축소 토글 -->
                                <ToggleButton x:Name="toggle"
                                              Grid.Column="0"
                                              Width="14" Height="14"
                                              Margin="0,0,4,0"
                                              IsChecked="{Binding IsExpanded,
                                                  RelativeSource={RelativeSource TemplatedParent},
                                                  Mode=TwoWay}"
                                              Visibility="Collapsed"
                                              Focusable="False">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Path x:Name="arrow"
                                                  Data="M 0 0 L 6 4 L 0 8 Z"
                                                  Fill="{DynamicResource Text3Brush}"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="0"/>
                                                </Path.RenderTransform>
                                            </Path>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="arrow"
                                                            Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="90"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <!-- 노드 콘텐츠 -->
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 자식 노드 -->
                        <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed"/>
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <!-- 자식 있을 때 토글 표시 -->
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="toggle" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <!-- 펼침 상태 -->
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <!-- 호버 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="rowBorder" Property="Background"
                                    Value="{DynamicResource CardBrush}"/>
                        </Trigger>

                        <!-- 선택됨 -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="rowBorder" Property="Background"
                                    Value="{DynamicResource AccFaintBrush}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource AccBrush}"/>
                        </Trigger>

                        <!-- 선택 + 호버 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected"   Value="True"/>
                                <Condition Property="IsMouseOver"  Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="rowBorder" Property="Background"
                                    Value="{DynamicResource AccFaintBrush}"/>
                        </MultiTrigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════
         §3 ─ 트리 노드 스타일 헬퍼
    ════════════════════════════════════════════ -->

    <Style x:Key="TreeNodeIcon" TargetType="TextBlock">
        <Setter Property="FontSize"  Value="13"/>
        <Setter Property="Margin"    Value="0,0,6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TreeNodeName" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="{DynamicResource FontBase}"/>
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TreeGroupName" TargetType="TextBlock"
           BasedOn="{StaticResource TreeNodeName}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <!-- ════════════════════════════════════════════
         §4 ─ 태그 목록 행
    ════════════════════════════════════════════ -->
    <Style x:Key="TagListRow" TargetType="Border">
        <Setter Property="Background"   Value="Transparent"/>
        <Setter Property="Padding"      Value="8,5"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TagName" TargetType="TextBlock">
        <Setter Property="FontSize"    Value="{DynamicResource FontBase}"/>
        <Setter Property="FontWeight"  Value="Medium"/>
        <Setter Property="FontFamily"  Value="{DynamicResource UiFont}"/>
        <Setter Property="Foreground"  Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style x:Key="TagValue" TargetType="TextBlock">
        <Setter Property="FontSize"    Value="11"/>
        <Setter Property="FontWeight"  Value="Bold"/>
        <Setter Property="FontFamily"  Value="{DynamicResource MonoFont}"/>
        <Setter Property="Foreground"  Value="{DynamicResource GreenBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <Style x:Key="TagTimestamp" TargetType="TextBlock">
        <Setter Property="FontSize"    Value="10"/>
        <Setter Property="FontFamily"  Value="{DynamicResource MonoFont}"/>
        <Setter Property="Foreground"  Value="{DynamicResource Text3Brush}"/>
    </Style>

    <!-- ════════════════════════════════════════════
         §5 ─ 알람 목록 행
    ════════════════════════════════════════════ -->
    <Style x:Key="AlarmRowHH" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource RedFaintBrush}"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource RedBrush}"/>
        <Setter Property="Padding"         Value="8"/>
        <Setter Property="Margin"          Value="0,0,0,4"/>
        <Setter Property="CornerRadius"    Value="{DynamicResource RadiusSm}"/>
        <Setter Property="Cursor"          Value="Hand"/>
    </Style>

    <Style x:Key="AlarmRowH" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource OrangeFaintBrush}"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource OrangeBrush}"/>
        <Setter Property="Padding"         Value="8"/>
        <Setter Property="Margin"          Value="0,0,0,4"/>
        <Setter Property="CornerRadius"    Value="{DynamicResource RadiusSm}"/>
        <Setter Property="Cursor"          Value="Hand"/>
    </Style>

    <Style x:Key="AlarmTagName" TargetType="TextBlock">
        <Setter Property="FontSize"    Value="{DynamicResource FontBase}"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="FontFamily"  Value="{DynamicResource UiFont}"/>
        <Setter Property="Foreground"  Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style x:Key="AlarmValue" TargetType="TextBlock">
        <Setter Property="FontSize"    Value="14"/>
        <Setter Property="FontWeight"  Value="Bold"/>
        <Setter Property="FontFamily"  Value="{DynamicResource MonoFont}"/>
        <Setter Property="Margin"      Value="0,2"/>
    </Style>

    <Style x:Key="AlarmTime" TargetType="TextBlock">
        <Setter Property="FontSize"    Value="10"/>
        <Setter Property="Foreground"  Value="{DynamicResource Text3Brush}"/>
        <Setter Property="FontFamily"  Value="{DynamicResource UiFont}"/>
    </Style>

</ResourceDictionary>
