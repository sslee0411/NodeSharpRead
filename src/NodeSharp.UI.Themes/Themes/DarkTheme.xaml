<!--
  DarkTheme.xaml
  ====================
  (ED-B0) 다크 테마 색상·브러시 정의. lssLib 원본 테마 자산이 이 개발 환경에는 없어(D:\lssLib
  미연결) 이 프로젝트에 맞춰 새로 설계함 — 사용자 확인, "새로 설계해서 만들기(추천)" 선택.
  나중에 실제 lssLib 테마로 교체하려면 이 파일의 Color/Brush 값만 바꾸면 된다(키 이름은
  LightTheme.xaml과 반드시 동일하게 유지 — DynamicResource가 그 키로 찾기 때문).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 색상(Color) — 브러시의 원본 값, 다른 곳에서 Color만 필요할 때 재사용 -->
    <Color x:Key="WindowBackgroundColor">#FF1E1E1E</Color>
    <Color x:Key="ControlBackgroundColor">#FF2D2D30</Color>
    <Color x:Key="BorderColor">#FF3F3F46</Color>
    <Color x:Key="PrimaryTextColor">#FFE0E0E0</Color>
    <Color x:Key="SecondaryTextColor">#FFA0A0A0</Color>
    <Color x:Key="AccentColor">#FF0078D4</Color>

    <!-- 브러시(Brush) — 실제 화면 요소(Background/Foreground 등)에 DynamicResource로 바인딩되는 값 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource ControlBackgroundColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

</ResourceDictionary>
