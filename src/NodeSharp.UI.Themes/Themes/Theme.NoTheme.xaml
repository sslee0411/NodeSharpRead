<!-- ══════════════════════════════════════════════════════════
     NodeSharp.UI.Themes · Themes/Theme.NoTheme.xaml
     테마: ⓪ No Theme — 시스템 기본 색상 (비교용)
     용도: 테마 미적용 상태와 테마 적용 상태를 비교하기 위한 레퍼런스.
           Windows 시스템 기본 색상에 최대한 근접한 값을 사용.
     ※ 키 이름은 Theme.DarkNavy.xaml과 100% 동일 유지
     출처: D:\lssLib\IIoT\IIoT.Solution\UI\Themes\IIoT.UI.Themes\Themes\Theme.NoTheme.xaml
           (ED-B4, "복사 참조" 포팅 — 색상값 원본과 100% 동일)
     ══════════════════════════════════════════════════════════ -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- §1 ─ 배경 색상 (Windows 11 기본 밝은 회색 계열) -->
    <Color x:Key="BgColor">#F0F0F0</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="CardColor">#FAFAFA</Color>
    <Color x:Key="BorderColor">#D0D0D0</Color>
    <Color x:Key="Border2Color">#B0B0B0</Color>

    <SolidColorBrush x:Key="BgBrush"      Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="CardBrush"    Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="BorderBrush"  Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="Border2Brush" Color="{StaticResource Border2Color}"/>

    <!-- §2 ─ 포인트 색상 (Windows 기본 파랑) -->
    <Color x:Key="AccColor">#0078D4</Color>
    <Color x:Key="Acc2Color">#106EBE</Color>

    <SolidColorBrush x:Key="AccBrush"      Color="{StaticResource AccColor}"/>
    <SolidColorBrush x:Key="Acc2Brush"     Color="{StaticResource Acc2Color}"/>
    <SolidColorBrush x:Key="AccFaintBrush"  Color="#150078D4"/>
    <SolidColorBrush x:Key="Acc2FaintBrush" Color="#15106EBE"/>

    <!-- §3 ─ 상태 색상 (시스템 기본) -->
    <Color x:Key="GreenColor">#107C10</Color>
    <Color x:Key="YellowColor">#CA8A00</Color>
    <Color x:Key="RedColor">#C42B1C</Color>
    <Color x:Key="OrangeColor">#D83B01</Color>
    <Color x:Key="BlueColor">#0078D4</Color>
    <Color x:Key="PurpleColor">#7719AA</Color>

    <SolidColorBrush x:Key="GreenBrush"  Color="{StaticResource GreenColor}"/>
    <SolidColorBrush x:Key="YellowBrush" Color="{StaticResource YellowColor}"/>
    <SolidColorBrush x:Key="RedBrush"    Color="{StaticResource RedColor}"/>
    <SolidColorBrush x:Key="OrangeBrush" Color="{StaticResource OrangeColor}"/>
    <SolidColorBrush x:Key="BlueBrush"   Color="{StaticResource BlueColor}"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}"/>

    <SolidColorBrush x:Key="GreenFaintBrush"  Color="#1A107C10"/>
    <SolidColorBrush x:Key="YellowFaintBrush" Color="#1ACA8A00"/>
    <SolidColorBrush x:Key="RedFaintBrush"    Color="#1AC42B1C"/>
    <SolidColorBrush x:Key="OrangeFaintBrush" Color="#1AD83B01"/>

    <!-- §4 ─ 텍스트 (검정 계열) -->
    <Color x:Key="TextColor">#1A1A1A</Color>
    <Color x:Key="Text2Color">#3B3B3B</Color>
    <Color x:Key="Text3Color">#767676</Color>

    <SolidColorBrush x:Key="TextBrush"  Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="Text2Brush" Color="{StaticResource Text2Color}"/>
    <SolidColorBrush x:Key="Text3Brush" Color="{StaticResource Text3Color}"/>

    <!-- §5 ─ 그라디언트 -->
    <LinearGradientBrush x:Key="ScaleArrowBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource Acc2Color}" Offset="0"/>
        <GradientStop Color="{StaticResource AccColor}"  Offset="0.5"/>
        <GradientStop Color="{StaticResource GreenColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PipelineBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource AccColor}"    Offset="0"/>
        <GradientStop Color="{StaticResource YellowColor}" Offset="0.6"/>
        <GradientStop Color="{StaticResource GreenColor}"  Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TopBarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F8F8F8" Offset="0"/>
        <GradientStop Color="#F0F0F0" Offset="1"/>
    </LinearGradientBrush>

    <!-- §6 ─ 격자 배경 -->
    <DrawingBrush x:Key="GridDotBrush" TileMode="Tile"
                  Viewport="0,0,20,20" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#C0C0C0">
                <GeometryDrawing.Geometry>
                    <EllipseGeometry Center="1,1" RadiusX="0.7" RadiusY="0.7"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="FlowCanvasGridBrush" TileMode="Tile"
                  Viewport="0,0,24,24" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#D0D0D088">
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="0,24" EndPoint="24,24"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#D0D0D088">
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="24,0" EndPoint="24,24"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- §7 ─ 폰트 (시스템 기본) -->
    <FontFamily x:Key="MonoFont">Consolas, Courier New</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI, Malgun Gothic, sans-serif</FontFamily>

    <!-- §8 ─ 치수 (시스템 기본 둥근 모서리) -->
    <CornerRadius x:Key="Radius">4</CornerRadius>
    <CornerRadius x:Key="RadiusSm">2</CornerRadius>
    <CornerRadius x:Key="RadiusLg">8</CornerRadius>
    <Thickness x:Key="PanelPadding">12,8</Thickness>
    <Thickness x:Key="CardPadding">14</Thickness>
    <Thickness x:Key="FieldMargin">0,0,0,9</Thickness>
    <sys:Double x:Key="LeftPanelWidth">220</sys:Double>
    <sys:Double x:Key="RightPanelWidth">268</sys:Double>
    <sys:Double x:Key="TopBarHeight">42</sys:Double>
    <sys:Double x:Key="SubTabHeight">38</sys:Double>
    <sys:Double x:Key="PanelHeaderHeight">32</sys:Double>
    <sys:Double x:Key="FontSm">10</sys:Double>
    <sys:Double x:Key="FontBase">12</sys:Double>
    <sys:Double x:Key="FontMd">13</sys:Double>
    <sys:Double x:Key="FontLg">15</sys:Double>
    <sys:Double x:Key="FontXl">18</sys:Double>
    <sys:Double x:Key="FontData">22</sys:Double>

    <!-- ══════════════════════════════════════════════
         §9 ─ NodeSharpRead 레거시 키 별칭 (ED-B4) — Theme.DarkNavy.xaml §9 설명 참고
    ══════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="WindowBackgroundBrush"  Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush"       Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush"     Color="{StaticResource Text2Color}"/>
    <SolidColorBrush x:Key="AccentBrush"            Color="{StaticResource AccColor}"/>

</ResourceDictionary>
