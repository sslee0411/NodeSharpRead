<!--
  LightTheme.xaml
  ====================
  (ED-B0) 라이트 테마 색상·브러시 정의. DarkTheme.xaml과 정확히 같은 리소스 키 목록을 다른
  색상값으로 정의한다 — ThemeManager.ApplyTheme이 이 파일로 교체해도 화면의 DynamicResource
  바인딩이 그대로 유효해야 하기 때문(키 하나라도 누락되면 그 요소만 테마 전환 시 깨짐).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 색상(Color) -->
    <Color x:Key="WindowBackgroundColor">#FFF5F5F5</Color>
    <Color x:Key="ControlBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="BorderColor">#FFD0D0D0</Color>
    <Color x:Key="PrimaryTextColor">#FF1E1E1E</Color>
    <Color x:Key="SecondaryTextColor">#FF606060</Color>
    <Color x:Key="AccentColor">#FF0078D4</Color>

    <!-- 브러시(Brush) — DarkTheme.xaml과 동일한 키 이름 유지 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource ControlBackgroundColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

</ResourceDictionary>
