<!-- ══════════════════════════════════════════════════════════
     NodeSharp.UI.Themes · Themes/Theme.NeonCyber.xaml
     테마: ③ Neon Cyber — 사이버펑크 네온 / 새벽 공장 제어실
     분위기: 형광 초록 + 마젠타 글로우, 각진 미래체, 스캔라인
     출처: D:\lssLib\IIoT\IIoT.Solution\UI\Themes\IIoT.UI.Themes\Themes\Theme.NeonCyber.xaml
           (ED-B4, "복사 참조" 포팅 — 색상값 원본과 100% 동일)
     ══════════════════════════════════════════════════════════ -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- §1 ─ 배경 색상 계층 -->
    <Color x:Key="BgColor">#040710</Color>
    <Color x:Key="SurfaceColor">#06091A</Color>
    <Color x:Key="CardColor">#080C20</Color>
    <Color x:Key="BorderColor">#0B1230</Color>
    <Color x:Key="Border2Color">#101D40</Color>

    <SolidColorBrush x:Key="BgBrush"      Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="CardBrush"    Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="BorderBrush"  Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="Border2Brush" Color="{StaticResource Border2Color}"/>

    <!-- §2 ─ 포인트 색상 -->
    <Color x:Key="AccColor">#00FFA3</Color>   <!-- 형광 청록 -->
    <Color x:Key="Acc2Color">#FF00CC</Color>  <!-- 마젠타 -->

    <SolidColorBrush x:Key="AccBrush"      Color="{StaticResource AccColor}"/>
    <SolidColorBrush x:Key="Acc2Brush"     Color="{StaticResource Acc2Color}"/>
    <SolidColorBrush x:Key="AccFaintBrush"  Color="#1A00FFA3"/>
    <SolidColorBrush x:Key="Acc2FaintBrush" Color="#1AFF00CC"/>

    <!-- §3 ─ 상태 색상 -->
    <Color x:Key="GreenColor">#00FFA3</Color>
    <Color x:Key="YellowColor">#FFE600</Color>
    <Color x:Key="RedColor">#FF1155</Color>
    <Color x:Key="OrangeColor">#FF6600</Color>
    <Color x:Key="BlueColor">#00CCFF</Color>
    <Color x:Key="PurpleColor">#CC00FF</Color>

    <SolidColorBrush x:Key="GreenBrush"  Color="{StaticResource GreenColor}"/>
    <SolidColorBrush x:Key="YellowBrush" Color="{StaticResource YellowColor}"/>
    <SolidColorBrush x:Key="RedBrush"    Color="{StaticResource RedColor}"/>
    <SolidColorBrush x:Key="OrangeBrush" Color="{StaticResource OrangeColor}"/>
    <SolidColorBrush x:Key="BlueBrush"   Color="{StaticResource BlueColor}"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}"/>

    <SolidColorBrush x:Key="GreenFaintBrush"  Color="#1A00FFA3"/>
    <SolidColorBrush x:Key="YellowFaintBrush" Color="#1AFFE600"/>
    <SolidColorBrush x:Key="RedFaintBrush"    Color="#1AFF1155"/>
    <SolidColorBrush x:Key="OrangeFaintBrush" Color="#1AFF6600"/>

    <!-- §4 ─ 텍스트 -->
    <Color x:Key="TextColor">#B0FFE0</Color>
    <Color x:Key="Text2Color">#4DFFB0</Color>
    <Color x:Key="Text3Color">#1A6644</Color>

    <SolidColorBrush x:Key="TextBrush"  Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="Text2Brush" Color="{StaticResource Text2Color}"/>
    <SolidColorBrush x:Key="Text3Brush" Color="{StaticResource Text3Color}"/>

    <!-- §5 ─ 그라디언트 -->
    <LinearGradientBrush x:Key="ScaleArrowBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource Acc2Color}" Offset="0"/>
        <GradientStop Color="{StaticResource AccColor}"  Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PipelineBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource AccColor}"   Offset="0"/>
        <GradientStop Color="{StaticResource YellowColor}" Offset="0.6"/>
        <GradientStop Color="{StaticResource GreenColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TopBarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#06091A" Offset="0"/>
        <GradientStop Color="#040710" Offset="1"/>
    </LinearGradientBrush>

    <!-- §6 ─ 격자 배경 (네온 그리드) -->
    <DrawingBrush x:Key="GridDotBrush" TileMode="Tile"
                  Viewport="0,0,28,28" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#0800FFA3">
                <GeometryDrawing.Geometry>
                    <EllipseGeometry Center="1,1" RadiusX="1" RadiusY="1"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="FlowCanvasGridBrush" TileMode="Tile"
                  Viewport="0,0,28,28" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#0800FFA3">
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="0,28" EndPoint="28,28"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#0800FFA3">
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="28,0" EndPoint="28,28"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- §7 ─ 폰트 (각진 미래체) -->
    <FontFamily x:Key="MonoFont">Rajdhani, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="UiFont">Rajdhani, Segoe UI, Malgun Gothic</FontFamily>

    <!-- §8 ─ 치수 (각진 — 최소 radius) -->
    <CornerRadius x:Key="Radius">2</CornerRadius>
    <CornerRadius x:Key="RadiusSm">1</CornerRadius>
    <CornerRadius x:Key="RadiusLg">3</CornerRadius>
    <Thickness x:Key="PanelPadding">12,8</Thickness>
    <Thickness x:Key="CardPadding">14</Thickness>
    <Thickness x:Key="FieldMargin">0,0,0,9</Thickness>
    <sys:Double x:Key="LeftPanelWidth">220</sys:Double>
    <sys:Double x:Key="RightPanelWidth">268</sys:Double>
    <sys:Double x:Key="TopBarHeight">42</sys:Double>
    <sys:Double x:Key="SubTabHeight">38</sys:Double>
    <sys:Double x:Key="PanelHeaderHeight">32</sys:Double>
    <sys:Double x:Key="FontSm">10</sys:Double>
    <sys:Double x:Key="FontBase">13</sys:Double>
    <sys:Double x:Key="FontMd">14</sys:Double>
    <sys:Double x:Key="FontLg">16</sys:Double>
    <sys:Double x:Key="FontXl">20</sys:Double>
    <sys:Double x:Key="FontData">24</sys:Double>


    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                     Color="#1A00FFA3"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                     Color="#B0FFE0"/>

    <!-- ══════════════════════════════════════════════
         §9 ─ NodeSharpRead 레거시 키 별칭 (ED-B4) — Theme.DarkNavy.xaml §9 설명 참고
    ══════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="WindowBackgroundBrush"  Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush"       Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush"     Color="{StaticResource Text2Color}"/>
    <SolidColorBrush x:Key="AccentBrush"            Color="{StaticResource AccColor}"/>

</ResourceDictionary>
