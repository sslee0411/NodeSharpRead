<!--
  MainWindow.xaml
  ====================
  (ED-B0) 완료 기준("다크/라이트 테마가 적용된 빈 창이 예외 없이 표시되는지")을 만족하는 최소
  화면으로 시작 — 배경/글자색을 DynamicResource로 테마 브러시에 연결해둔 빈 창 하나뿐이었다.
  (ED-B1) 완료 기준("헤더/메뉴/본문 3영역이 렌더링되고 창 크기 조절 시 레이아웃이 깨지지 않는지")에
  맞춰 상단 메뉴(헤더)·좌측 네비게이션·본문 영역 3분할 뼈대로 확장.
  (ED-B2a) 본문 영역을 FlowCanvasView/StructureView 2개로 채움 — 02번 문서 8번 탭 카드15가
  "화면 전환 없이 하나의 창 안에서 GridSplitter로 항상 함께 보인다(분할 도킹)"고 확정해뒀음을
  뒤늦게 발견해, 원래 03번 Step맵의 "전환 버튼" 문구를 카드15에 맞춰 정정하고 이 방식으로 구현
  (전환 버튼 없음, 항상 둘 다 보임). 좌측 네비게이션의 "Flow"/"구조 설정" 2개 항목도 실제로는
  전환 대상이 아니라 항상 함께 보이는 같은 화면이라 "Flow / 구조 설정" 1개 항목으로 합쳤다.
  (ED-B2b) Sequence Editor·Dashboard는 11번 탭 카드6/9번 탭 설계대로 각각 별도 창으로 뜨는
  화면이라(이 창 안에 넣지 않음), 지금은 진입점만 만든다 — 헤더 "보기" 메뉴에 하위 항목 2개를
  추가하고, ED-B2a부터 있던 좌측 네비게이션의 Sequence/Dashboard 항목도 클릭 가능하게 만들어
  두 진입점 모두 같은 안내 메시지(placeholder)를 띄우도록 연결했다(실제 창은 Phase 10/11).
  (ED-B3, 사용자 요청) OS 기본 제목표시줄(밝은 회색, 다크 테마와 어울리지 않음)을 12번 탭 카드2
  통합 작업 화면 목업의 커스텀 타이틀바(어두운 배경 + 아이콘 + 제목 + 최소화/최대화/닫기 버튼)로
  교체 — WindowStyle="None"+WindowChrome으로 OS 크롬을 없애고, Row 0에 직접 그린 타이틀바가 그
  역할을 대신한다. 드래그 이동·더블클릭 최대화는 WindowChrome이 기본 제공(버튼 3개만
  IsHitTestVisibleInChrome="True"로 예외 처리). 열린 파일명·미저장 표시(●)·상태 배지는 목업에는
  있지만 그 데이터(EditorSessionState, 8번 탭 카드16)가 아직 없어(EC-04/ED-D13 이후) 이번엔 넣지
  않았다 — 지금은 고정 제목 텍스트만 표시.
-->
<Window x:Class="NodeSharp.Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NodeSharp.Editor.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NodeSharp Editor"
        Height="600" Width="900" MinHeight="400" MinWidth="600"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStyle="None"
        ResizeMode="CanResize"
        StateChanged="OnWindowStateChanged">
    <shell:WindowChrome.WindowChrome>
        <!-- CaptionHeight를 아래 타이틀바 Row 높이(32)와 맞춰야 드래그 이동·더블클릭 최대화가
             타이틀바 영역과 정확히 일치한다. ResizeBorderThickness는 WindowStyle="None"에서도
             가장자리로 창 크기를 조절할 수 있게 남겨두는 여백. -->
        <shell:WindowChrome CaptionHeight="32"
                             ResizeBorderThickness="4"
                             GlassFrameThickness="0"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- (ED-B3) 타이틀바 버튼 3개(최소화/최대화/닫기) 공용 — WPF 기본 Button 크롬(회색 3D
             테두리)을 없애고 Border+ContentPresenter만 남겨 밋밋하고 평평한 모양으로 통일한다. -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 닫기 버튼은 다른 두 버튼과 달리 호버 시 빨간색으로 강조(Windows 표준 관례). -->
        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E81123" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- (ED-B3) 커스텀 타이틀바 — WindowChrome CaptionHeight와 동일한 32 -->
            <RowDefinition Height="32" />
            <!-- 헤더(상단 메뉴) — 내용물 높이만큼만 차지 -->
            <RowDefinition Height="Auto" />
            <!-- 남은 공간 전부(좌측 네비게이션 + 본문) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- (ED-B3) 커스텀 타이틀바 — 아이콘+제목은 드래그 가능 영역(WindowChrome 기본 동작),
             버튼 3개만 IsHitTestVisibleInChrome="True"로 예외 처리해 실제 클릭이 되게 한다. -->
        <Grid Grid.Row="0" Background="{DynamicResource ControlBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="🟠" FontSize="13"
                       Margin="10,0,6,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="NodeSharpRead Editor"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       FontSize="12" VerticalAlignment="Center" />

            <Button x:Name="MinimizeButton" Grid.Column="2" Content="─"
                    Style="{StaticResource TitleBarButtonStyle}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="OnMinimizeClick" />
            <Button x:Name="MaximizeRestoreButton" Grid.Column="3" Content="☐"
                    Style="{StaticResource TitleBarButtonStyle}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="OnMaximizeRestoreClick" />
            <Button x:Name="CloseButton" Grid.Column="4" Content="✕"
                    Style="{StaticResource TitleBarCloseButtonStyle}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="OnCloseClick" />
        </Grid>

        <!-- (ED-B1) 헤더 — 상단 메뉴. (ED-B2b) "보기" 메뉴에 Sequence Editor/Dashboard 진입점 추가
             — 나머지 메뉴(파일/편집/도움말)는 아직 하위 항목 없이 자리만 잡아둔 상태 그대로. -->
        <Border Grid.Row="1"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Menu Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}">
                <MenuItem Header="파일" />
                <MenuItem Header="편집" />
                <MenuItem Header="보기">
                    <MenuItem Header="Sequence Editor" Click="OnSequenceEditorEntryClick" />
                    <MenuItem Header="Dashboard" Click="OnDashboardEntryClick" />
                </MenuItem>
                <MenuItem Header="도움말" />
            </Menu>
        </Border>

        <!-- (ED-B1) 본문 행 — 좌측 네비게이션(고정 폭 범위) + 본문 영역(남은 폭 전부) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- MinWidth/MaxWidth로 창을 아무리 늘리거나 줄여도 네비게이션 폭이 너무
                     좁아지거나(글자 잘림) 너무 넓어지지(공간 낭비) 않게 범위를 고정 -->
                <ColumnDefinition Width="180" MinWidth="120" MaxWidth="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 좌측 네비게이션 — (ED-B2a) "Flow"/"구조 설정"은 카드15에 따라 항상 함께 보이는
                 같은 화면이라 1개 항목으로 합침. (ED-B2b) Sequence/Dashboard는 헤더 "보기" 메뉴와
                 동일한 진입점이라 같은 클릭 핸들러로 연결(Cursor=Hand로 클릭 가능함을 시각적으로 표시). -->
            <Border Grid.Column="0"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <StackPanel Margin="8">
                    <TextBlock Text="Flow / 구조 설정" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4" FontSize="14" />
                    <TextBlock Text="Sequence" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4" FontSize="14"
                               Cursor="Hand" MouseLeftButtonUp="OnSequenceEditorEntryClick" />
                    <TextBlock Text="Dashboard" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4" FontSize="14"
                               Cursor="Hand" MouseLeftButtonUp="OnDashboardEntryClick" />
                </StackPanel>
            </Border>

            <!-- (ED-B2a) 본문 영역 — FlowCanvasView(좌)·StructureView(우)가 GridSplitter로 폭만
                 조절 가능할 뿐, 화면 전환 없이 항상 동시에 보인다(카드15 "항상 분할 도킹"). -->
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="320" MinWidth="200" MaxWidth="600" />
                </Grid.ColumnDefinitions>

                <views:FlowCanvasView Grid.Column="0" />

                <GridSplitter Grid.Column="1"
                               Width="5"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               Background="{DynamicResource BorderBrush}"
                               ShowsPreview="True" />

                <views:StructureView Grid.Column="2" />
            </Grid>
        </Grid>
    </Grid>
</Window>
