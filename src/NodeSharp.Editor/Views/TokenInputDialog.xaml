<!--
  TokenInputDialog.xaml
  ====================
  (LK-03) "파일 → Runner 토큰 입력" 메뉴가 띄우는 단순 모달 — 02번 설계 문서 7번 탭 카드6
  "원격 PC는 사용자가 직접 입력해 접속한다"를 실제로 받는 화면. 프로젝트에 아직 범용 텍스트 입력
  대화상자가 없어(지금까지는 OpenFileDialog 같은 OS 표준 다이얼로그만 사용) NodePropertyDialog와
  동일한 관례(커스텀 타이틀바 없음, WindowStartupLocation="CenterOwner", ResizeMode="NoResize",
  우측 하단 취소/확인 버튼)로 최소 구현했다 — 새 NuGet 의존성을 추가하지 않는다.
-->
<Window x:Class="NodeSharp.Editor.Views.TokenInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Runner 토큰 입력"
        Width="420" SizeToContent="Height" MinHeight="160"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <StackPanel Margin="16">
        <TextBlock Text="Runner의 runner.token 값을 입력하세요(같은 PC면 자동으로 읽히므로 보통 필요 없습니다 — 원격 PC이거나 자동 인식에 실패했을 때만 사용)."
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBox x:Name="TokenTextBox"
                 Background="{DynamicResource ControlBackgroundBrush}"
                 Foreground="{DynamicResource PrimaryTextBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 Padding="4" Margin="0,0,0,14" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="취소" Width="70" Margin="0,0,8,0" IsCancel="True" Click="OnCancelClick" />
            <Button x:Name="OkButton" Content="확인" Width="70" IsDefault="True" Click="OnOkClick" />
        </StackPanel>
    </StackPanel>
</Window>
