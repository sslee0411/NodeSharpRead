<!--
  ColorPickerDialog.xaml
  ====================
  (EC-20) "카드 색상은 색상파레트 에서 선택해서 할수 있도록" — NodePropertyDialog의 "카드 색상"
  필드 옆 "선택..." 버튼이 여는 스와치 팔레트 모달. TokenInputDialog와 동일한 최소 모달 관례
  (커스텀 타이틀바 없음, WindowStartupLocation="CenterOwner", ResizeMode="NoResize", 우측 하단
  취소/확인 버튼)를 따른다 — 새 NuGet 의존성을 추가하지 않는다.
-->
<Window x:Class="NodeSharp.Editor.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="색상 선택"
        Width="360" SizeToContent="Height" MinHeight="200"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <StackPanel Margin="16">
        <TextBlock Text="아래 팔레트에서 색을 클릭하거나, 16진 색상 코드를 직접 입력하세요."
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,10" />
        <WrapPanel x:Name="SwatchPanel" Margin="0,0,0,12" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <TextBox x:Name="HexBox"
                     Width="120"
                     Background="{DynamicResource ControlBackgroundBrush}"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     Padding="4"
                     TextChanged="OnHexBoxTextChanged" />
            <Border x:Name="PreviewBox"
                    Width="28" Height="28" Margin="8,0,0,0"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Background="Transparent" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="취소" Width="70" Margin="0,0,8,0" IsCancel="True" Click="OnCancelClick" />
            <Button x:Name="OkButton" Content="확인" Width="70" IsDefault="True" Click="OnOkClick" />
        </StackPanel>
    </StackPanel>
</Window>
