<!--
  StructureNodePropertyDialog.xaml
  ====================
  (ED-D02a/b) 구조 설정 트리(StructureTreeNode, ED-D01) 노드 1개의 속성을 편집하는 모달 — 02번
  설계문서 8번 탭 카드4("우측 편집기: 선택 노드의 PropertySchema를 9번 탭 NodePropertyDialog
  렌더러로 그대로 표시")가 요구하는 편집 폼을 NodePropertyDialog.xaml과 동일한 레이아웃(이름 →
  설명 → PropertySchema 필드들 → 취소/완료 버튼)으로 제공한다. FlowCanvasView가 캔버스 노드 카드를
  더블클릭하면 NodePropertyDialog를 띄우는 것(EC-03)과 동일하게, StructureView도 트리 행을
  더블클릭하면 이 다이얼로그를 띄운다(일관된 앱 전체 관례).
-->
<Window x:Class="NodeSharp.Editor.Views.StructureNodePropertyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="속성 편집"
        Width="420" SizeToContent="Height" MinHeight="200"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- NodePropertyDialog와 동일하게 이름은 PropertySchema 소속이 아니라 고정 필드로 맨 위에 둔다. -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="이름" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" />
            <TextBox x:Name="NameBox"
                     Background="{DynamicResource ControlBackgroundBrush}"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     BorderBrush="{DynamicResource BorderBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="설명" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" />
            <TextBox x:Name="DescriptionBox"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="50"
                     VerticalScrollBarVisibility="Auto"
                     Background="{DynamicResource ControlBackgroundBrush}"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     BorderBrush="{DynamicResource BorderBrush}" />
        </StackPanel>

        <!-- PropertySchema 필드는 코드비하인드 BuildFields가 여기에 동적으로 채운다. -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="360">
            <StackPanel x:Name="FieldsPanel" />
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="취소" Width="70" Margin="0,0,8,0" Click="OnCancelClick" />
            <Button x:Name="OkButton" Content="완료" Width="70" Click="OnOkClick" />
        </StackPanel>
    </Grid>
</Window>
