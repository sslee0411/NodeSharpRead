<!--
  SequenceEditorWindow.xaml
  ====================
  (SQ-02) 캔버스(FlowCanvasView)와 별개의 독립 WPF Window로 뜨는 Sequence Editor — 02번 설계 문서
  11번 탭 카드6("캔버스와 별개의 독립 Window")을 실제로 여는 첫 Step. ED-B2b가 만든 진입점(메뉴/좌측
  네비게이션)이 지금까지는 MessageBox 안내만 띄웠는데, 이 Step부터 실제 Window가 뜬다.
  TokenInputDialog(LK-03)/NodePropertyDialog와 동일한 DynamicResource 브러시 관례를 따르되, 이
  Window는 모달 대화상자가 아니라(SequenceWindowManager가 재사용하는 비모달 창) ResizeMode는
  CanResize, WindowStartupLocation은 Manual(SequenceWindowManager가 이전 위치를 복원하거나, 최초
  1회는 MainWindow 기준 CenterOwner 좌표를 계산해 채움).

  (SQ-03, ★ 보강) 완료 기준의 "역방향"(호출하는 Flow 노드 보기)을 최소한으로 확인할 수 있게, "시퀀스
  Id" TextBox 1개 + "호출하는 Flow 노드 보기" Button 1개를 추가했다. 아직 sequences.json 저장/로드가
  없어(SQ-04 이전) 이 창이 "지금 편집 중인 시퀀스"를 스스로 알 방법이 없으므로, SequenceTriggerNode를
  더블클릭해 열면(편도) 그 노드의 sequenceId가 자동으로 채워지고, 사용자가 직접 타이핑해 다른 Id를
  조회할 수도 있다(TagCatalog 도입 전 TagRef가 거쳤던 것과 동일한 "직접 입력" 임시 단계).

  (SQ-04, ★ 보강) AskUserQuestion으로 사용자 확인("최소 단계 추가/삭제 UI까지 지금 구현") 결과에 따라
  placeholder 안내문을 실제 단계 목록 편집 UI로 교체한다 — "불러오기"/"저장" 버튼으로 sequences.json을
  읽고 쓰고(SequenceStore, FlowStore와 동일한 패턴), "+ 단계 추가"/"- 단계 삭제" 버튼으로 단계를
  추가·삭제한다. 이 두 편집 동작은 IEditorCommand(AddSequenceStepCommand/RemoveSequenceStepCommand)로
  구현되어 SequenceWindowManager가 연결해주는 공유 CommandHistory(EC-07, FlowCanvas와 동일 스택)의
  Undo/Redo 대상이 된다. 단계 순서변경(드래그)·조건식(TriggerExpression)/동작(ActionType/ActionParams)
  상세 편집 UI는 여전히 후속 Step 범위(02번 문서 11번 탭 카드5 참고 — SequenceStepDto 필드 전체를
  다루는 상세 편집기는 별도 판단이 필요한 확장). StructureView(ED-D13)의 프로그래밍 방식 렌더링
  (RenderTree 패턴)을 그대로 따라 단계 목록도 StackPanel에 코드비하인드로 직접 렌더링한다(XAML
  ItemsControl 데이터 바인딩 대신 — 이 프로젝트 전체의 기존 관례).
-->
<Window x:Class="NodeSharp.Editor.Views.SequenceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sequence Editor"
        Width="640" Height="420" MinWidth="420" MinHeight="280"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
            <TextBlock Text="시퀀스 Id:" Foreground="{DynamicResource PrimaryTextBrush}"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="SequenceIdBox" Width="160"
                     Background="{DynamicResource ControlBackgroundBrush}"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     Padding="4" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button x:Name="LoadButton" Content="불러오기" Padding="10,4" Click="OnLoadClick" Margin="0,0,8,0" />
            <Button x:Name="SaveButton" Content="저장" Padding="10,4" Click="OnSaveClick" Margin="0,0,12,0" />
            <Button x:Name="FindCallersButton" Content="호출하는 Flow 노드 보기"
                    Padding="10,4" Click="OnFindCallersClick" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="AddStepButton" Content="+ 단계 추가" Padding="10,4" Click="OnAddStepClick" Margin="0,0,8,0" />
            <Button x:Name="RemoveStepButton" Content="- 단계 삭제" Padding="10,4" Click="OnRemoveStepClick" />
            <TextBlock Text="(순서변경·조건/동작 상세 편집은 후속 Step 범위)"
                       Foreground="{DynamicResource PrimaryTextBrush}" Opacity="0.6"
                       VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11" />
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="StepsPanel" Margin="4" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
