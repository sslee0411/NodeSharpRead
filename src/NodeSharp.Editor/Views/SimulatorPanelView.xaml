<!--
  SimulatorPanelView.xaml
  ========================
  (PD-01d, ★ 신규) 03번 Step맵 PD-01c가 구현한 VirtualModbusSlave(메모리 기반 가상 Modbus 슬레이브,
  drivers\NodeSharp.Drivers.Modbus\VirtualModbusSlave.cs)를 실제 하드웨어 없이 손으로 조작할 수 있게
  하는 Editor 다섯 번째 사이드바 탭 — "시뮬레이션 모드"(PlcNode.SimulationMode)로 표시된 PLC를 목록에서
  고르면, 그 PLC 전용 VirtualModbusSlave의 레지스터(주소+값) 목록을 보고 값을 직접 수정할 수 있습니다.

  범위(사용자 확인, 2026-09-02, "체크박스+패널 UI만 우선 구현"): 이 화면은 여기서 수정한 값이
  캔버스 PlcTagReadNode 출력에 실시간 반영되는 것까지는 아직 하지 않습니다 — DeviceMapPoller가 아직
  실제 IProtocolDriver를 호출하지 않고 TagValueUpdatedEvent도 발행하지 않기 때문(PD-01a 당시
  LL-05a 미구현과 동일한 유형의 더 깊은 공백)입니다. 그 배선은 후속 Step PD-01e로 분리했습니다 —
  이 화면은 어디까지나 VirtualModbusSlave 자체를 들여다보고 값을 미리 채워두는 용도입니다.

  PLC 목록은 StructureView.xaml.cs(ED-D01)와 동일하게 TreeView 대신 Border+StackPanel을 코드비하인드
  에서 직접 그리는 패턴을 재사용합니다(이 프로젝트가 WPF 기본 TreeView/TabControl/ComboBox의
  Background/Foreground 무시 버그를 이미 여러 번 겪었기 때문 — StructureView.xaml 상단 주석 참고).
  레지스터 표는 반대로, NodeSharp.UI.Themes\Styles\Styles.Layout.xaml의 IIoTGrid 계열 스타일(주소+값
  같은 진짜 표 형태 데이터를 위해 이미 마련돼 있었지만 이 코드베이스에서 처음 실제로 쓰이는 스타일)을
  적용한 DataGrid를 씁니다 — Border+StackPanel로 표를 흉내내는 것보다 정렬·인라인 편집이 훨씬 자연스러워
  이 화면에 한해 새로 도입합니다.
-->
<UserControl x:Class="NodeSharp.Editor.Views.SimulatorPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource ControlBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0 — 헤더 + 새로고침(StructureView "+ 장비" 버튼과 동일한 Border+MouseLeftButtonDown 패턴). -->
        <Grid Grid.Row="0" Margin="10,10,10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="시뮬레이션 모드 PLC"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Border x:Name="RefreshButton"
                    Grid.Column="1"
                    Background="Transparent"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8,3"
                    Cursor="Hand">
                <TextBlock Text="새로고침" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" />
            </Border>
        </Grid>

        <!-- Row 1 — PLC 목록(장비명 › PLC명). 목록이 길어질 상황을 대비해 높이를 제한하고 스크롤. -->
        <Grid Grid.Row="1" Margin="10,0,10,8">
            <TextBlock x:Name="EmptyPlcHint"
                       Text="시뮬레이션 모드로 켜둔 PLC가 없습니다. 구조 설정 탭에서 PLC 속성의 &quot;시뮬레이션 모드&quot;를 켜세요."
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       FontSize="11" />
            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PlcListPanel" />
            </ScrollViewer>
        </Grid>

        <!-- Row 2 — 선택된 PLC의 레지스터 표(주소+값) + 추가 입력행. -->
        <Grid Grid.Row="2" Margin="10,0,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="NoPlcSelectedHint"
                       Grid.Row="0"
                       Grid.RowSpan="3"
                       Text="위 목록에서 PLC를 선택하면 레지스터 값을 볼 수 있습니다."
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

            <StackPanel x:Name="AddRegisterRow" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
                <TextBlock Text="주소" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox x:Name="AddressInput" Width="60" Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,10,0" />
                <TextBlock Text="값" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox x:Name="ValueInput" Width="70" Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,10,0" />
                <Border x:Name="AddRegisterButton"
                        Background="Transparent"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,3"
                        Cursor="Hand">
                    <TextBlock Text="추가/수정" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" />
                </Border>
            </StackPanel>

            <!-- (주소, 값) 0~65535 범위는 코드비하인드(SimulatorPanelView.xaml.cs)에서 검사·클램프합니다
                 — Modbus 레지스터 주소 공간·값 범위 모두 VirtualModbusSlave와 동일 기준(ushort). -->
            <DataGrid x:Name="RegisterGrid"
                      Grid.Row="2"
                      Style="{DynamicResource IIoTGrid}"
                      IsReadOnly="False"
                      Visibility="Collapsed">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="주소" Binding="{Binding Address}" IsReadOnly="True" Width="*" />
                    <DataGridTextColumn Header="값" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
