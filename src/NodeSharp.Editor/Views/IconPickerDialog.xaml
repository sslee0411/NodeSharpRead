<!--
  IconPickerDialog.xaml
  ====================
  (EC-20) "아이콘의 경우 웹에 공유되어 있는 아이콘을 선택해서 할 수 있도록" — NodePropertyDialog의
  "아이콘" 필드 옆 "선택..." 버튼이 여는 Font Awesome 아이콘 그리드 모달. 검색창 + 스크롤 가능한
  아이콘 그리드로 구성되며, 아이콘을 클릭하면 즉시 선택·확정된다(별도 "확인" 버튼 불필요 — 취소만
  둠). TokenInputDialog/ColorPickerDialog와 동일한 최소 모달 관례(커스텀 타이틀바 없음,
  WindowStartupLocation="CenterOwner", ResizeMode="NoResize")를 따른다.
-->
<Window x:Class="NodeSharp.Editor.Views.IconPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="아이콘 선택"
        Width="420" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top"
                   Text="아이콘 이름이나 설명으로 검색하거나, 그리드에서 클릭해 바로 선택하세요."
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBox x:Name="SearchBox" DockPanel.Dock="Top"
                 Background="{DynamicResource ControlBackgroundBrush}"
                 Foreground="{DynamicResource PrimaryTextBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 Padding="4" Margin="0,0,0,8"
                 TextChanged="OnSearchTextChanged" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CancelButton" Content="취소" Width="70" IsCancel="True" Click="OnCancelClick" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="IconPanel" />
        </ScrollViewer>
    </DockPanel>
</Window>
