<!--
  PaletteView.xaml
  ====================
  (EC-01a) FlowCanvasView 좌측에 항상 떠 있는 노드 팔레트 — 02번 문서 9번 탭 카드10 "팔레트
  검색바"/"최근 사용 5개" 목업(12번 탭 카드2 mock-palette)을 그대로 따른다. 검색창이 비어 있으면
  "최근 사용" 섹션 + 전체 카드 목록을, 검색어가 있으면 TypeName/Category가 일치하는 카드만 보여준다.
  이 시점(Phase 6 시작)엔 NodeTypeRegistry에 등록된 노드 타입이 아직 없어(Phase 7에서 채워짐) 카드
  목록이 비어 있는 것이 정상이며, 그럴 때는 안내 문구(EmptyHint)를 보여준다.
  (EC-01b) 카드에 PreviewMouseLeftButtonDown/PreviewMouseMove를 추가해, 마우스를 누른 채 임계값
  이상 움직이면 WPF 표준 드래그 앤 드롭을 시작한다(FlowCanvasView의 NodeCanvas가 받는다) — 임계값
  을 넘지 않는 단순 클릭은 그대로 기존 MouseLeftButtonUp(OnCardClicked)이 처리한다.
-->
<UserControl x:Class="NodeSharp.Editor.Views.PaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource ControlBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 검색창 — WPF 표준 워터마크 스타일 없이 위에 작은 안내 텍스트만 둔다(단순함 우선) -->
        <StackPanel Grid.Row="0" Margin="6">
            <TextBlock Text="🔍 노드 검색"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="11" Margin="0,0,0,2" />
            <TextBox x:Name="SearchBox"
                     Padding="4"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     Background="{DynamicResource WindowBackgroundBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     TextChanged="OnSearchTextChanged" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="6,0,6,6">
                <!-- 검색어가 비어 있을 때만 보이는 "최근 사용" 섹션 -->
                <TextBlock x:Name="RecentHeader"
                           Text="최근 사용"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,4" />
                <ItemsControl x:Name="RecentItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource WindowBackgroundBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1" CornerRadius="3"
                                    Margin="0,2" Padding="6" Cursor="Hand"
                                    Tag="{Binding TypeName}"
                                    PreviewMouseLeftButtonDown="OnCardPreviewMouseDown"
                                    PreviewMouseMove="OnCardPreviewMouseMove"
                                    MouseLeftButtonUp="OnCardClicked">
                                <TextBlock Foreground="{DynamicResource PrimaryTextBrush}">
                                    <Run Text="{Binding IconGlyph, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding TypeName, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 검색어가 비어 있으면 전체 카드, 있으면 필터링된 카드만 표시 -->
                <TextBlock Text="전체"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,10,0,4" />
                <ItemsControl x:Name="AllItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource WindowBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="3"
                                    Margin="0,2" Padding="6" Cursor="Hand"
                                    Tag="{Binding TypeName}"
                                    PreviewMouseLeftButtonDown="OnCardPreviewMouseDown"
                                    PreviewMouseMove="OnCardPreviewMouseMove"
                                    MouseLeftButtonUp="OnCardClicked">
                                <StackPanel>
                                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}">
                                        <Run Text="{Binding IconGlyph, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding TypeName, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Category, Mode=OneWay}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="10" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyHint"
                           Text="등록된 노드 타입이 아직 없습니다 — Phase 7에서 Inject·Switch·Function·Debug가 추가되면 채워집니다."
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Margin="0,10,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
