<!--
  DebugSidebarView.xaml
  ====================
  (LK-02b) Node-RED Editor의 "Debug" 사이드바 탭에 대응 — Runner가 SignalR로 보낸
  DebugMessageEvent/NodeErrorEvent를 시간순으로 쌓아 보여주는 읽기 전용 목록이다. "일시정지"를
  누르면 그 뒤에 들어오는 이벤트를 무시하고(코드비하인드 IsPaused 참고, Node-RED 원본과 달리
  버퍼링하지 않고 그냥 버림), "지우기"는 지금까지 쌓인 항목을 전부 지운다. InformationPanelView와
  동일하게 항목이 없으면 안내 문구만 남긴다.
-->
<UserControl x:Class="NodeSharp.Editor.Views.DebugSidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource ControlBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 일시정지/지우기 — 이 프로젝트의 키 있는 Button 스타일(Styles.Controls.xaml GhostBtn 등)은
             실제 Theme.*.xaml 브러시 키와 이름 체계가 달라 어디서도 쓰이지 않는 상태라(코드비하인드
             클래스 주석 참고), FlowCanvasView.RenderFlowTabStrip의 "＋"/"✕"와 동일하게 네이티브
             Button 대신 Border + MouseLeftButtonDown으로 안전하게 구현한다. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,10,10,4">
            <Border x:Name="PauseButton"
                    Background="Transparent"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8,3"
                    Margin="0,0,6,0"
                    Cursor="Hand">
                <TextBlock x:Name="PauseButtonLabel" Text="일시정지" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" />
            </Border>
            <Border x:Name="ClearButton"
                    Background="Transparent"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8,3"
                    Cursor="Hand">
                <TextBlock Text="지우기" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" />
            </Border>
        </StackPanel>

        <TextBlock x:Name="EmptyHint"
                   Grid.Row="1"
                   Text="Runner가 보내는 디버그 메시지/오류가 여기에 표시됩니다."
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap"
                   Margin="10"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

        <ScrollViewer x:Name="ContentScroll"
                      Grid.Row="1"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentPanel" Margin="10" />
        </ScrollViewer>
    </Grid>
</UserControl>
