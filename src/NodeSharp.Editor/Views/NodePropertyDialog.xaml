<!--
  NodePropertyDialog.xaml
  ====================
  (EC-03) 노드 속성 편집 다이얼로그 — 12번 탭 카드3 목업(라벨+입력 컨트롤+고정 노출 도움말)을 그대로
  따른다. PropertyField.Type에 따라 입력 컨트롤이 자동으로 바뀌고(TextBox/PasswordBox/CheckBox/
  ComboBox 등, 코드비하인드 CreateInputControl), 모든 필드에 HelpText가 항상 보이며 Example이 있으면
  그것도 함께 보인다(개발 지침 4번). TagRef는 ComboBox로 렌더링하되, (ED-D04) 이제 구조 설정 트리의
  실시간 태그 목록(NodeSharp.Editor.Structure.TagCatalog)을 실제 선택지로 채운다 — 화면엔 사람이
  읽는 경로가 보이지만 저장 값은 항상 태그의 고유 Id라 이름이 바뀌어도 연동이 끊기지 않는다. 메인
  창과 달리 커스텀 타이틀바(ED-B3)는 적용하지 않음 — 모달 다이얼로그는 OS 기본 창 틀로도 목업
  (카드3)이 요구하는 모습과 다르지 않다.
  (EC-11) 이름 아래에 "설명"(NodeConfig.Description) 여러 줄 텍스트박스를 고정 필드로 추가 — 02번
  문서 9번 탭 카드16이 "노드 편집 다이얼로그에 설명 탭을 추가하면 문서 배지가 표시되고 클릭 시
  팝업으로 보여준다"고 명시한 값으로, PropertySchema 소속 필드가 아니라 이름과 동일하게 고정 위치에
  둔다(탭이 아니라 폼 상단 필드로 구현 — 이미 폼 자체가 모달 하나뿐이라 별도 탭 컨트롤을 새로
  두는 것보다 이름 옆에 나란히 두는 편이 더 단순함).
-->
<Window x:Class="NodeSharp.Editor.Views.NodePropertyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="속성 편집"
        Width="420" SizeToContent="Height" MinHeight="200"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 이름은 PropertySchema 소속이 아니라 NodeConfig.Name 자체라 고정 필드로 맨 위에 둔다. -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="이름" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" />
            <TextBox x:Name="NameBox"
                     Background="{DynamicResource ControlBackgroundBrush}"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     BorderBrush="{DynamicResource BorderBrush}" />
        </StackPanel>

        <!-- (EC-11) 설명 — NodeConfig.Description. 채워두면 캔버스 카드에 문서 배지가 표시되고
             클릭 시 팝업으로 이 텍스트를 그대로 보여준다. -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="설명" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" />
            <TextBox x:Name="DescriptionBox"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="60"
                     VerticalScrollBarVisibility="Auto"
                     Background="{DynamicResource ControlBackgroundBrush}"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     BorderBrush="{DynamicResource BorderBrush}" />
        </StackPanel>

        <!-- PropertySchema 필드는 코드비하인드 BuildFields가 여기에 동적으로 채운다. -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="360">
            <StackPanel x:Name="FieldsPanel" />
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="취소" Width="70" Margin="0,0,8,0" Click="OnCancelClick" />
            <Button x:Name="OkButton" Content="완료" Width="70" Click="OnOkClick" />
        </StackPanel>
    </Grid>
</Window>
