<!--
  NodePropertyDialog.xaml
  ====================
  (EC-03) 노드 속성 편집 다이얼로그 — 12번 탭 카드3 목업(라벨+입력 컨트롤+고정 노출 도움말)을 그대로
  따른다. PropertyField.Type에 따라 입력 컨트롤이 자동으로 바뀌고(TextBox/PasswordBox/CheckBox/
  ComboBox 등, 코드비하인드 CreateInputControl), 모든 필드에 HelpText가 항상 보이며 Example이 있으면
  그것도 함께 보인다(개발 지침 4번). TagRef는 이 Step 요구대로 ComboBox로 렌더링하되, 실제 태그
  목록(구조 설정 데이터)은 Phase 9 이후에나 채워지므로 지금은 빈 콤보박스로 표시된다(카드3 목업의
  <select disabled>와 같은 취지). 메인 창과 달리 커스텀 타이틀바(ED-B3)는 적용하지 않음 — 모달
  다이얼로그는 OS 기본 창 틀로도 목업(카드3)이 요구하는 모습과 다르지 않다.
-->
<Window x:Class="NodeSharp.Editor.Views.NodePropertyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="속성 편집"
        Width="420" SizeToContent="Height" MinHeight="200"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 이름은 PropertySchema 소속이 아니라 NodeConfig.Name 자체라 고정 필드로 맨 위에 둔다. -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="이름" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" />
            <TextBox x:Name="NameBox"
                     Background="{DynamicResource ControlBackgroundBrush}"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     BorderBrush="{DynamicResource BorderBrush}" />
        </StackPanel>

        <!-- PropertySchema 필드는 코드비하인드 BuildFields가 여기에 동적으로 채운다. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="360">
            <StackPanel x:Name="FieldsPanel" />
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="취소" Width="70" Margin="0,0,8,0" Click="OnCancelClick" />
            <Button x:Name="OkButton" Content="완료" Width="70" Click="OnOkClick" />
        </StackPanel>
    </Grid>
</Window>
