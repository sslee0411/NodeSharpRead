<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NodeSharp.Drivers.Modbus
    ====================
    IProtocolDriver(CT-09)의 Modbus 1차 구현체 — nodes\ 폴더의 코어 노드 플러그인과 동일한 관례로
    별도 최상위 폴더(drivers\)에 독립 csproj로 둔다. IProtocolDriver.cs의 remarks가 "드라이버 dll
    자체의 로드/언로드는 PluginLoadContext/PluginLoader(CT-06a)를 그대로 재사용"한다고 명시하므로,
    nodes\ 프로젝트들과 마찬가지로 NodeSharp.Contracts만 참조하고(Registry/Runtime/Editor 비참조)
    System.Net.Sockets(BCL)만으로 TCP 프레이밍을 직접 처리한다(ModbusDriver.cs 클래스 remarks —
    LL-05a NodeSharp.Util.Net이 아직 없어서 임시로 직접 처리, LL-05a 구현 후 리팩터링 예정).

    Step: PD-01a (03번 개발 Step맵.html, Phase 9 — ModbusDriver TCP 모드)
    - 착수 배경: 사용자가 "빌드 확인 다음단계 진행해줘"로 확인(ED-D03과 동일하게 테스트/동작 확인
      문구 없어 ED-D01/ED-D02a/ED-D03 모두 ⏳ 대기 유지) — 표 순서상 다음은 ED-D04(TagRef 연동)지만,
      PD-01a 행 desc가 명시적으로 "표에서는 뒤쪽에 배치돼 있지만 실제 착수는 ED-D01 직후·ED-D02a~D04
      보다 먼저 — TagRef·PLC Write 안전장치·DeviceMapPoller가 모두 이 드라이버를 전제하기 때문"이라고
      적어둔 순서 메모를 이번에 반영해 ED-D04보다 PD-01a를 먼저 착수(README v3.13에서 이미 "PD-01a
      선행 필요"로 예고해둔 그대로).
    - 조사: PD-01a 설명이 전제하는 "LL-05a로 포팅된 NodeSharp.Util.Net의 NetTransportType.Tcp"가
      저장소 전체 검색 결과 어디에도 존재하지 않음을 확인(LL-05a는 Phase 12, 아직 ⏳ 대기) — LL-05a를
      먼저 통째로 구현하는 대신(9종 Transport 전체 포팅은 이 Step 범위를 크게 벗어남), ModbusDriver가
      System.Net.Sockets.TcpClient로 직접 MBAP 프레이밍을 처리하도록 결정(사용자 확인 없이 결정,
      근거는 ModbusDriver.cs 클래스 remarks에 기록 — LL-05a 완료 후 그 추상화로 리팩터링 예정임을
      명시).
    - ModbusDriver.cs 신규 — IProtocolDriver 구현(Type=ModbusTcp, ConnectAsync/ReadAsync/WriteAsync).
      FC03(Read Holding Registers)/FC06(Write Single Register)/FC16·0x10(Write Multiple Registers)
      MBAP 프레이밍 조립·파싱, Modbus 예외 응답(함수 코드 최상위 비트) 감지 시 ModbusException.
      RTU 모드(IsRtu=true)는 PD-01b 예정이라 ConnectAsync가 NotSupportedException으로 즉시 안내.
      주소는 IProtocolDriver.cs 예시(ReadAsync(startAddress: 40001, ...))를 그대로 따라 40001 같은
      전통적 오프셋 변환 없이 프로토콜 주소 필드에 그대로 실음(그런 변환 규칙이 설계문서에 없음).
    - test\NodeSharp.Tests\ModbusDriverTests.cs 신규 — 실제 PLC 하드웨어 없이 완료 기준("실제(또는
      시뮬레이터) Modbus TCP 슬레이브에 연결해 ReadAsync로 값을 읽고, WriteAsync로 쓴 값이 다시
      읽었을 때 반영되는지")을 증명하기 위해, 테스트 전용 FakeModbusTcpSlave(로컬 루프백 TcpListener +
      메모리 기반 레지스터 배열, FC03/06/16 응답)를 자체 구현. NodeSharp.Tests.csproj에 이 프로젝트
      ProjectReference 추가.
    - check-xmldoc.py 0건, ModbusDriver.cs/ModbusDriverTests.cs 중괄호 균형 확인, NodeSharpRead.sln에
      새 프로젝트 항목 추가. .NET SDK가 없는 샌드박스라 dotnet build/test는 사용자 로컬 확인 필요.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NodeSharp.Drivers.Modbus</RootNamespace>
    <AssemblyName>NodeSharp.Drivers.Modbus</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- IProtocolDriver.cs remarks — 드라이버 플러그인은 Contracts만 참조. -->
    <ProjectReference Include="..\..\src\NodeSharp.Contracts\NodeSharp.Contracts.csproj" />
  </ItemGroup>

</Project>
